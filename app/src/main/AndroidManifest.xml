<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera"
        android:required="true"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AplicativoConect"
        tools:targetApi="31">

        <activity
            android:name=".view.telaprincipal.tela_inicial"
            android:exported="false" />
        <activity
            android:name=".view.formcadastro.tela_cadastro"
            android:exported="false" />
        <activity
            android:name=".view.telaLogin.telaLogin"
            android:exported="false" />
        <activity
            android:name=".view.telaLogin.tela_bem_vindo3"
            android:exported="false" />
        <activity
            android:name=".view.telaLogin.tela_bem_vindo2"
            android:exported="false" />
        <activity
            android:name=".view.telaLogin.tela_bem_vindo"
            android:exported="false" />
        <activity
            android:name=".view.telaLogin.splash_background"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>