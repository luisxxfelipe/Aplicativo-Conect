<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        android:id="@+id/titulo_popup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="Ações"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_adicionar_servicos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:padding="12dp"
        android:text="Adicionar Serviços"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/roxo"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_service"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titulo_popup" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ajustar_horario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:text="Ajustar Horário"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/roxo"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_clock"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_adicionar_servicos" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_publicar_fotos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:text="Publicar Fotos"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/roxo"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_photo"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_ajustar_horario" />

</androidx.constraintlayout.widget.ConstraintLayout>