<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera"
        android:required="true"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="Conectx"
        android:icon="@drawable/lauch_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.AplicativoConect"
        tools:targetApi="31">

        <!-- Tela de Splash -->
        <activity
            android:name=".view.ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela de boas-vindas -->
        <activity
            android:name=".view.ui.WelcomeActivity"
            android:exported="true" />

        <!-- Tela de Login -->
        <activity
            android:name=".view.ui.auth.LoginActivity"
            android:exported="true" />

        <!-- Tela de Signup -->
        <activity
            android:name=".view.ui.auth.SignupActivity"
            android:exported="true" />

        <!-- Tela de Home do Cliente -->
        <activity
            android:name=".view.ui.client.ClientHomeActivity"
            android:exported="true" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>
</manifest>
