<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:fillViewport="true">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novo Agendamento"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Nome do Cliente">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="@color/black"
                    android:backgroundTint="@android:color/transparent"
                    android:inputType="textPersonName"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Selecione o Serviço"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/spinnerService"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSelectDate"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="Selecionar Data"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp"
                android:visibility="visible"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/colorPrimary" />

            <TextView
                android:id="@+id/textViewSelectedDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data não selecionada"
                android:gravity="center"
                android:textAlignment="center"
                android:visibility="gone"
                android:textColor="@color/cinza"
                android:layout_marginTop="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSelectTime"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="Selecionar Horário"
                android:visibility="gone"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/colorPrimary" />

            <TextView
                android:id="@+id/textViewSelectedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Horário não selecionado"
                android:gravity="center"
                android:textAlignment="center"
                android:visibility="gone"
                android:textColor="@color/cinza"
                android:layout_marginTop="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSaveBooking"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="Salvar Agendamento"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                android:backgroundTint="@color/roxo" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</ScrollView>
