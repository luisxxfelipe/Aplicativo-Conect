<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="POLÍTICA DE PRIVACIDADE"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Introduction Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="INTRODUÇÃO"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="8dp"
                android:text="Esta política de privacidade descreve como coletamos, usamos e protegemos as informações pessoais dos usuários do nosso aplicativo. A proteção da sua privacidade é muito importante para nós, por isso, nos comprometemos a processar seus dados pessoais de maneira responsável e transparente."
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <!-- Data Collection Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="COLETA DE DADOS"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="8dp"
                android:text="Coletamos dados fornecidos diretamente pelo usuário, como nome, email e endereço. Também podemos coletar dados automáticos, como informações do dispositivo e do uso do aplicativo. O consentimento explícito será solicitado antes da coleta desses dados, sempre que necessário."
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <!-- Information Usage Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="USO DAS INFORMAÇÕES"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="8dp"
                android:text="As informações coletadas são utilizadas para melhorar a experiência do usuário, personalizar o conteúdo do aplicativo, enviar notificações importantes sobre serviços e cumprir obrigações legais e regulatórias. Se aplicável, também podemos usar dados para marketing personalizado, desde que o usuário tenha dado consentimento explícito."
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <!-- Data Sharing Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="COMPARTILHAMENTO DE DADOS"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="8dp"
                android:text="Não vendemos ou compartilhamos dados pessoais com terceiros sem o consentimento do usuário, exceto quando exigido por lei ou necessário para a prestação dos serviços. Podemos compartilhar dados com prestadores de serviços, que são obrigados a adotar medidas adequadas de segurança e a processar os dados apenas conforme nossas instruções."
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <!-- Storage and Security Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ARMAZENAMENTO E SEGURANÇA"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="8dp"
                android:text="Armazenamos as informações em servidores seguros e adotamos medidas apropriadas de segurança, como criptografia, para proteger os dados contra acesso não autorizado. No entanto, nenhum método de transmissão de dados pela internet ou de armazenamento eletrônico é 100% seguro."
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <!-- Cookies Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="COOKIES E TECNOLOGIAS SEMELHANTES"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="8dp"
                android:text="Podemos utilizar cookies e outras tecnologias para coletar informações sobre o uso do aplicativo e melhorar nossos serviços. O usuário pode configurar o seu dispositivo para recusar cookies ou alertá-lo quando cookies estiverem sendo enviados."
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <!-- User Rights Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="DIREITOS DO USUÁRIO"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="8dp"
                android:text="O usuário tem o direito de acessar, corrigir ou excluir seus dados pessoais, bem como solicitar a suspensão do uso dos dados para determinadas finalidades. O consentimento dado pode ser revogado a qualquer momento, sem que isso afete a legalidade do tratamento realizado antes da revogação."
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <!-- Policy Changes Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ALTERAÇÕES NA POLÍTICA"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="8dp"
                android:text="Esta política pode ser atualizada periodicamente. Notificaremos os usuários sobre mudanças significativas por meio de avisos no aplicativo ou por email. Recomendamos que o usuário leia periodicamente esta política para estar ciente de qualquer alteração."
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <!-- Contact Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="CONTATO"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="8dp"
                android:text="Em caso de dúvidas sobre nossa política de privacidade ou para exercer seus direitos, entre em contato conosco pelo email: conectexoficial@gmail.com."
                android:textColor="@android:color/black"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
