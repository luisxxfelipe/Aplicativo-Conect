<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="48dp"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/selector_calendar_day"
    android:padding="4dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp">

    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="21"
        android:textColor="@color/calendar_day_text_selector"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDayWeek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seg"
        android:textColor="@color/calendar_day_week_text_selector"
        android:textSize="12sp" />

</LinearLayout>
