<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título dos Agendamentos -->
    <TextView
        android:id="@+id/bookingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="Agendamentos"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- RecyclerView único para todos os agendamentos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewBookings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true"
        android:visibility="gone" />

    <!-- Layout para mensagem de lista vazia -->
    <LinearLayout
        android:id="@+id/emptyBookingsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/emptyBookingsMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ainda não há agendamentos."
            android:textAlignment="center"
            android:textColor="@color/cinza" />

        <ImageView
            android:id="@+id/emptyBookingsImage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/sem_agendamentos" />
    </LinearLayout>
</LinearLayout>
