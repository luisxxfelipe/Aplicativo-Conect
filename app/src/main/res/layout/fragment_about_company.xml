<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- FrameLayout para a imagem de capa e a imagem de perfil sobreposta -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <!-- Imagem de capa da empresa -->
        <ImageView
            android:id="@+id/companyImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="Descrição da empresa"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_overlay" />
    </FrameLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-50dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Imagem de perfil sobreposta -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/companyProfileImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentStart="true"
            android:elevation="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/foto_perfil_generica" />

        <!-- Nome da empresa ao lado da imagem de perfil -->
        <TextView
            android:id="@+id/companyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_toEndOf="@id/companyProfileImage"
            android:text="Nome da Empresa"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Horário de funcionamento -->
        <TextView
            android:id="@+id/companyOperatingHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/companyName"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_toEndOf="@id/companyProfileImage"
            android:text="Horário: 8:00 - 18:00"
            android:textSize="14sp" />

        <!-- Categoria -->
        <TextView
            android:id="@+id/companyCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/companyOperatingHours"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_toEndOf="@id/companyProfileImage"
            android:text="Categoria: Estética"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- Descrição da empresa -->
    <TextView
        android:id="@+id/companyDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="16dp"
        android:text="Descrição do trabalho da empresa"
        android:textSize="16sp" />

    <!-- Tabs de navegação -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Conteúdo para cada aba (Serviços, Fotos, Avaliação) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>
