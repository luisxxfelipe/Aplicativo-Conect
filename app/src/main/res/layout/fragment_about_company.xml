<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- FrameLayout para a imagem de capa e a imagem de perfil sobreposta -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <!-- Imagem de capa da empresa -->
        <ImageView
            android:id="@+id/companyImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:contentDescription="Descrição da empresa" />


        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_overlay" />
    </FrameLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="-50dp">

        <!-- Imagem de perfil sobreposta -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/companyProfileImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/foto_perfil_generica"
            android:scaleType="centerCrop"
            android:elevation="4dp" />

        <!-- Nome da empresa ao lado da imagem de perfil -->
        <TextView
            android:id="@+id/companyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/companyProfileImage"
            android:layout_marginStart="16dp"
            android:text="Nome da Empresa"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <!-- Horário de funcionamento -->
        <TextView
            android:id="@+id/companyOperatingHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/companyName"
            android:layout_toEndOf="@id/companyProfileImage"
            android:layout_marginStart="16dp"
            android:text="Horário: 8:00 - 18:00"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- Categoria -->
        <TextView
            android:id="@+id/companyCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/companyOperatingHours"
            android:layout_toEndOf="@id/companyProfileImage"
            android:layout_marginStart="16dp"
            android:text="Categoria: Estética"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </RelativeLayout>

    <!-- Seção de descrição e serviços -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/companyDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição do trabalho da empresa"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Serviços"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/servicesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</LinearLayout>
