<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Imagem de perfil da empresa -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/companyProfileImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:elevation="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_profile_default" />

    <!-- Nome da empresa -->
    <TextView
        android:id="@+id/companyName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:text="Nome da Empresa"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Horário de funcionamento -->
    <TextView
        android:id="@+id/companyOperatingHours"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:text="Horário: 8:00 - 18:00"
        android:textSize="14sp" />

    <!-- Endereço clicável para Maps -->
    <LinearLayout
        android:id="@+id/addressContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/rounded_background"
        android:clickable="true"
        android:focusable="true"
        android:backgroundTint="#F5F5F5"
        android:elevation="1dp">

        <!-- Ícone do Google Maps no início -->
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Localização"
            app:srcCompat="@drawable/ic_maps_foreground" />

        <!-- TextView para o endereço -->
        <TextView
            android:id="@+id/address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Endereço não informado"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Ícone atrativo de direcionamento -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Abrir no Maps"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/colorPrimary" />

    </LinearLayout>


    <!-- Descrição da empresa -->
    <TextView
        android:id="@+id/companyDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:text="Descrição do trabalho da empresa"
        android:textSize="16sp" />


    <!-- Tabs de navegação -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <!-- Conteúdo para cada aba (Serviços, Fotos, Avaliação) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>
