<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Estado quando pressionado -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/card_background" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/roxo" />
            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="12dp"
                android:bottom="8dp" />
        </shape>
    </item>
    
    <!-- Estado quando focado -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/card_background" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/roxo" />
            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="12dp"
                android:bottom="8dp" />
        </shape>
    </item>
    
    <!-- Estado padrão -->
    <item>
        <shape>
            <solid android:color="@color/card_background" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/cinza_claro" />
            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="12dp"
                android:bottom="8dp" />
        </shape>
    </item>
    
</selector>
